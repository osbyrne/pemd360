{
  "name": "pemd360",
  "version": "1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "admin:create": "bun run scripts/create-admin.ts",
    "prepare": "svelte-kit sync || echo ''; git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@libsql/client": "^0.18.0",
    "@matterport/sdk": "^1.6.0",
    "@stylexjs/stylex": "^0.19.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.6",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "effect": "4.0.5",
    "exceljs": "^4.4.0",
    "lucide-svelte": "^1.0.1",
    "nanoid": "^6.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "resend": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@vite-pwa/sveltekit": "^1.1.0",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.131.0"
  }
}
